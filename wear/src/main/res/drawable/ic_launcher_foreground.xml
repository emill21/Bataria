<?xml version="1.0" encoding="utf-8"?>
<!-- Bataria "Liquid Orb": level ring around a glass orb of liquid with a bolt. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- Ring track -->
    <path
        android:pathData="M23,54a31,31 0,1 0,62 0a31,31 0,1 0,-62 0z"
        android:strokeColor="#FFAEF2BA"
        android:strokeAlpha="0.35"
        android:strokeWidth="3" />
    <!-- Ring progress -->
    <path
        android:pathData="M54,23 A31,31 0,1 1,26 67"
        android:strokeColor="#FFAEF2BA"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />

    <!-- Glass -->
    <path
        android:pathData="M28,54a26,26 0,1 0,52 0a26,26 0,1 0,-52 0z"
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.08" />

    <group>
        <clip-path android:pathData="M28,54a26,26 0,1 0,52 0a26,26 0,1 0,-52 0z" />
        <!-- Back wave -->
        <path
            android:pathData="M20,58 C30,52 40,52 50,57 C60,62 70,62 88,55 V90 H20 Z"
            android:fillColor="#FFAEF2BA"
            android:fillAlpha="0.45" />
        <!-- Front wave -->
        <path android:pathData="M20,56 C32,62 42,62 54,56 C66,50 76,50 88,57 V90 H20 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="54" android:startY="50"
                    android:endX="54" android:endY="82"
                    android:startColor="#FFC8F7CF"
                    android:endColor="#FF7ED99A" />
            </aapt:attr>
        </path>
        <!-- Bubbles -->
        <path
            android:pathData="M43,70a2,2 0,1 0,4 0a2,2 0,1 0,-4 0z M58.6,74a1.4,1.4 0,1 0,2.8 0a1.4,1.4 0,1 0,-2.8 0z"
            android:fillColor="#FF0B3D20"
            android:fillAlpha="0.25" />
        <!-- Shine -->
        <path android:pathData="M28,54a26,26 0,1 0,52 0a26,26 0,1 0,-52 0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="44" android:centerY="44"
                    android:gradientRadius="22"
                    android:startColor="#38FFFFFF"
                    android:endColor="#00FFFFFF" />
            </aapt:attr>
        </path>
    </group>

    <!-- Bolt -->
    <path
        android:pathData="M57,35 L45,55 H53 L50,71 L63,50 H55 Z"
        android:fillColor="#FF0B3D20" />
</vector>
